# PostgreSQL для сервера (collect.py читает эти переменные).
# Если не заданы — collect.py пишет в CSV (папка results/).
RPM_PG_HOST=localhost
RPM_PG_PORT=5432
RPM_PG_DB=parser
RPM_PG_USER=postgres
RPM_PG_PASSWORD=

# Необязательно: переопределить пути
# RPM_PROFILES=/opt/rpm/profiles
# RPM_RESULTS=/opt/rpm/results
# RPM_CONFIG=/opt/rpm/config.json
# RPM_PRODUCTS=/opt/rpm/products.json
