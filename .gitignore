# ============================================
# СЕКРЕТЫ — никогда не коммитить
# ============================================
.env
.env.*
!.env.example

# ключи: скрываем всё содержимое папки, кроме публичных .pub
# (именно keys/* , а не keys/ — иначе git не заглянет внутрь
#  и исключение !keys/*.pub перестанет работать)
keys/*
!keys/*.pub

*.pem
*.key
*.ppk
id_rsa*
id_ed25519*
.ssh/

# прокси и учётки
proxy*.txt
proxies*.txt
*credentials*
config.json

# куки и сессии
cookies/
*.cookies
*cookie*.json

# ============================================
# Окружения и кэш
# ============================================
venv/
.venv/
**/.venv/
**/venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/

# ============================================
# Рабочие данные и артефакты прогонов
# ============================================
profiles/
results/
parser/results/
debug/
logs/
*.log
*.zip

# ============================================
# Архив — хлам, отложенный до необходимости
# ============================================
_archive/

# ============================================
# Мусор ОС и IDE
# ============================================
$Recycle.Bin/
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/

# ============================================
# Claude Code — локальные настройки, не общие
# ============================================
.claude/settings.local.json
